    {
      "parameters": {
        "jsCode": "const data = JSON.parse($input.first().json.choices[0].message.content);\nconst sum = (data.items || []).reduce((s, i) => s + (i.qty || 0) * (i.harga || 0), 0);\nconst total = data.total ?? sum;\nconst valid = data.total == null ? null : data.total === sum;\nreturn [{ json: { ...data, total, totalHitung: sum, valid } }];"
